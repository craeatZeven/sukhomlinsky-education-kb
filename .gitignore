# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Local working copies / private notes (do not commit)
local_working_copy/
*.local.md

# Generated backend database (rebuild with: python scripts/build_db.py)
api/kb.db
api/kb.db-wal
api/kb.db-shm

# 离线影子分片（file:// 下替代 fetch 的 .json.js）
# 生成物、可再生产 → 不进版本库（REPO-POLICY 铁律 4）。
# 重建：python scripts/build_offline_shims.py
web/data/**/*.json.js
# 单卡打包文件不叫 *.json.js，单独列一条 —— 漏了会把 5 MB 生成物提交上去
web/data/cards-all.js

# Python
__pycache__/
*.pyc
.venv/

# Cloudflare Workers 构建产物（源码保留：wrangler.toml / package.json / src/ / schema.sql / README.md）
cloudflare/node_modules/
cloudflare/.wrangler/
cloudflare/data.sql
cloudflare/schema_fts.sql
cloudflare/coverage.json

# codex/playwright 工具产生的临时截图与控制台日志（不是项目产物）
.playwright-mcp/

# 批量核查的中间产物（分片、批处理稿）——可再生产，不是项目产物
runs/

# 浏览器回归脚本的运行产物（脚本本身在 tools/web-audit/，是要提交的）
tools/web-audit/out/

# 个人层：批注 / 待办 / 摘录。**故意不入库**——一旦 push 到公开仓库，
# 就会永久留在 git 历史里（本仓库有过一次密钥进历史的教训，代价是重写 246 个提交）。
# 个人内容要异地备份，走 OneDrive / 外置盘，不走公开 git。
notes/

# Obsidian：只提交配置（app.json / community-plugins.json），
# workspace 是每次打开的窗口状态，graph 是关系图的显示设置（过滤器/颜色/力参数）——
# 两者都是**视图状态**，随你每次调而变，属运行态，不入库。
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/cache
.obsidian/plugins/*/data.json

